@'
# === Безопасность ===
TREASURY_USERNAME=treasury
TREASURY_PASSWORD=change_me_in_production

# === Курсы ЦБ ===
CBR_API_URL=https://www.cbr-xml-daily.ru/daily_json.js
CBR_CACHE_TTL_SECONDS=300

# === Лимиты позиций ===
POSITION_LIMIT_USD=100000
POSITION_LIMIT_EUR=100000

# === Спреды (0.005 = 0.5%) ===
DEFAULT_SPREAD_BUY=0.005
DEFAULT_SPREAD_SELL=0.005

# === База данных ===
DATABASE_PATH=fx_deals.db

# === Логирование ===
LOG_LEVEL=INFO

# === Сервер ===
HOST=127.0.0.1
PORT=8000
'@ | Set-Content -Path .env.example -Encoding UTF8